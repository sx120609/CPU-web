{
  "name": "cpu-web-desktop",
  "version": "0.3.0",
  "description": "药大拾间桌面客户端",
  "main": "dist/electron/main.js",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean": "rimraf dist release",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets:installer": "electron scripts/build-installer-assets.cjs",
    "vendor:deps": "node scripts/vendor-deps.mjs",
    "vendor:verify": "node scripts/vendor-deps.mjs --verify",
    "test": "npm run build && node scripts/policy-test.cjs && node scripts/multiplatform-test.cjs && node scripts/campus-net-test.cjs && node scripts/oauth-user-test.cjs && node scripts/userscript-update-test.cjs && node scripts/script-config-test.cjs && node scripts/ai-request-size-test.cjs && node scripts/learning-access-test.cjs && node scripts/session-persistence-test.cjs && node scripts/shell-style-test.cjs && node scripts/portable-ui-test.cjs && node scripts/vendor-deps.mjs --verify",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs",
    "test:package": "node scripts/package-check.cjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && node scripts/prepare-nsis.cjs && electron-builder --win --publish never",
    "dist:mac:arm64": "bash scripts/prepare-macos-icon.sh && npm run build && electron-builder --mac --arm64 --publish never"
  },
  "build": {
    "appId": "cn.lizmt.cpuweb.desktop",
    "productName": "药大拾间桌面端",
    "copyright": "Copyright © 2026 药大拾间",
    "asar": true,
    "compression": "normal",
    "files": [
      "dist/**",
      "assets/**",
      "src/shell/**",
      "src/installer/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-win-${arch}-安装版.${ext}",
    "electronLanguages": [
      "zh-CN"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": "cpu-web-desktop-setup",
      "artifactName": "${productName}-${version}-win-${arch}-安装版.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-arm64.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "backgroundColor": "#f4f8f7",
      "sign": false
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "//": "electron 的 postinstall 负责下载 Chromium 二进制，不放行的话装完是空壳。其余依赖一律不放行。",
    "electron": true
  }
}
