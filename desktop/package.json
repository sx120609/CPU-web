{
  "name": "cpu-web-desktop",
  "version": "0.1.0",
  "description": "药大拾间桌面端 —— 授权登录后在受控窗口中打开学习平台并启用学习辅助脚本",
  "main": "dist/electron/main.js",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean": "rimraf dist release",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vendor:deps": "node scripts/vendor-deps.mjs",
    "vendor:verify": "node scripts/vendor-deps.mjs --verify",
    "test": "npm run build && node scripts/policy-test.cjs && node scripts/campus-net-test.cjs && node scripts/vendor-deps.mjs --verify",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs",
    "test:package": "node scripts/package-check.cjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "cn.lizmt.cpuweb.desktop",
    "productName": "药大拾间桌面端",
    "copyright": "Copyright © 2026 药大拾间",
    "asar": true,
    "files": [
      "dist/**",
      "assets/**",
      "src/launcher/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-win-${arch}-安装版.${ext}",
    "electronLanguages": [
      "zh-CN"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "药大拾间",
      "installerLanguages": ["zh_CN"],
      "deleteAppDataOnUninstall": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "//": "electron 的 postinstall 负责下载 Chromium 二进制，不放行的话装完是空壳。其余依赖一律不放行。",
    "electron": true
  }
}
