{
  "mode": "observe",
  "logPath": "/var/log/nginx/cpu-web-waf.jsonl",
  "stateDirectory": "/var/lib/cpu-web-waf",
  "hosts": ["cputime.cn", "www.cputime.cn"],
  "protectedGroups": ["share"],
  "allowCidrs": [],
  "trustedProxyCidrs": [],
  "protectedTcpPorts": [443],
  "dedicatedIngressConfirmed": false,
  "sharedIngress": true,
  "nginxBinary": "/www/server/nginx/sbin/nginx",
  "nginxConfig": "/www/server/nginx/conf/nginx.conf",
  "adaptiveCooldownSeconds": 180,
  "windowSeconds": 10,
  "minimumRequests": 200,
  "attackMinimumRequests": 100,
  "concentration": 0.95,
  "minimumRejectedFraction": 0.5,
  "attackRequestsPerSecond": 150,
  "baselineMultiplier": 4,
  "recoverySeconds": 60,
  "banSeconds": 300,
  "maximumBanSeconds": 3600,
  "strikeMemorySeconds": 86400,
  "maximumClients": 20000,
  "maximumBans": 2048,
  "maximumReadBytes": 4194304,
  "maximumBacklogBytes": 16777216,
  "pollSeconds": 0.5
}
