[Unit]
Description=CPU-web adaptive CC guard
After=network.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/cpu-web-waf/agent.py run --config /etc/cpu-web-waf/config.json
Restart=on-failure
RestartSec=5
StateDirectory=cpu-web-waf
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/log/nginx
ReadWritePaths=/var/lib/cpu-web-waf
ReadWritePaths=/var/log/nginx -/www/wwwlogs -/www/server/nginx/logs
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=256M
CPUQuota=50%
Nice=10

[Install]
WantedBy=multi-user.target
