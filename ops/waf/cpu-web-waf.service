[Unit]
Description=CPU-web adaptive CC guard
After=network.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/cpu-web-waf/agent.py run --config /etc/cpu-web-waf/config.json
Restart=on-failure
RestartSec=5
StateDirectory=cpu-web-waf
NoNewPrivileges=true
# Campus default: nginx config validation/reload works, kernel IP isolation cannot.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
# nginx -t opens access logs; ProtectSystem already makes all other paths read-only.
ReadWritePaths=/var/lib/cpu-web-waf
ReadWritePaths=/var/log/nginx -/www/wwwlogs -/www/server/nginx/logs
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=256M
CPUQuota=50%
Nice=10

[Install]
WantedBy=multi-user.target
