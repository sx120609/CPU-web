<?xml version="1.0" encoding="utf-8"?>
<!-- 日程小组件：逾期待办、两周内的日程和没有日期的待办，点圆圈就勾选完成（iOS AgendaWidget）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/agenda_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="日程"
            android:textColor="@color/widget_accent"
            android:textSize="15dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary_text"
            android:textSize="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/agenda_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="接下来两周没有日程，点这里添加"
        android:textColor="@color/widget_secondary_text"
        android:textSize="13dp"
        android:visibility="gone" />

        <LinearLayout
            android:id="@+id/agenda_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/agenda_check_0"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="完成"
                android:padding="7dp"
                android:src="@drawable/ic_agenda_unchecked" />

            <TextView
                android:id="@+id/agenda_title_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/agenda_meta_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/agenda_check_1"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="完成"
                android:padding="7dp"
                android:src="@drawable/ic_agenda_unchecked" />

            <TextView
                android:id="@+id/agenda_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/agenda_meta_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/agenda_check_2"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="完成"
                android:padding="7dp"
                android:src="@drawable/ic_agenda_unchecked" />

            <TextView
                android:id="@+id/agenda_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/agenda_meta_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/agenda_check_3"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="完成"
                android:padding="7dp"
                android:src="@drawable/ic_agenda_unchecked" />

            <TextView
                android:id="@+id/agenda_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/agenda_meta_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/agenda_check_4"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="完成"
                android:padding="7dp"
                android:src="@drawable/ic_agenda_unchecked" />

            <TextView
                android:id="@+id/agenda_title_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/agenda_meta_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agenda_row_5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/agenda_check_5"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="完成"
                android:padding="7dp"
                android:src="@drawable/ic_agenda_unchecked" />

            <TextView
                android:id="@+id/agenda_title_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/agenda_meta_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="12dp" />
        </LinearLayout>

</LinearLayout>
