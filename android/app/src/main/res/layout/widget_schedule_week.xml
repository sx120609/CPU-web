<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:text="药大课表"
            android:textColor="#172033"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_refresh_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="刷新"
            android:textColor="#168776"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="第 1 周 · 08/31 - 09/06"
        android:textColor="#667085"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_week_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="周课表"
            android:scaleType="fitXY"
            android:src="@drawable/widget_schedule_week_preview" />

        <TextView
            android:id="@+id/widget_week_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="18dp"
            android:text="正在读取课表..."
            android:textColor="#475467"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="配置后会自动刷新"
        android:textColor="#98A2B3"
        android:textSize="10sp" />
</LinearLayout>
