PORT=3000
DATABASE_URL="file:./dev.db"
JWT_SECRET="cpu-web-dev-secret-please-change-in-production"
JWT_EXPIRES_IN="7d"
NODE_ENV=development

# 宿舍电费接口 base URL。
# 默认走校内 frp 穿透出来的公网地址 http://sz.weicheng.wang:8899（无需校园网）。
# 想换隧道地址或直连内网时设此变量。
# DORM_ELECTRIC_BASE=http://sz.weicheng.wang:8899

# ============ 教务代理：主服务侧配置 ============
# 不配置 JWXT_PROXY_URL 时，主服务会保持本地直连教务系统的旧模式。
# 配置后，主服务不再持有教务 cookie，而是把教务登录/课表/成绩等请求转发到代理服务。
# 学校公告爬虫的网页抓取与 HTML 解析也会走同一个代理，主服务只负责调度和入库。
# JWXT_PROXY_URL=http://你的-frp-地址:23334
# JWXT_PROXY_AUTH=主服务调用代理时发送的共享密钥，必须和代理端 PROXY_AUTH 完全一致
# JWXT_PROXY_TIMEOUT_MS=15000

# ============ 教务代理：代理端配置 ============
# 在代理机器上运行 npm run proxy / npm run proxy:dev 时使用。
# 代理端只需要暴露一个 HTTP JSON 服务，生产建议通过 HTTPS 或 frp 隧道访问。
# 生成共享密钥示例：openssl rand -hex 32
# PROXY_AUTH=代理端校验的共享密钥，必须和主服务 JWXT_PROXY_AUTH 完全一致
# PROXY_PORT=23334
