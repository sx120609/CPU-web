PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/cpu_web?schema=public"
# 药苑之声保留 VoiceHub 原始数据模型，必须使用独立数据库，不能指向上面的 cpu_web 主库。
VOICEHUB_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/cpu_web_voicehub"
# 本地开发默认 3001；Linux 一键部署脚本会自动改用本机 23335。
VOICEHUB_ORIGIN="http://127.0.0.1:3001"
VOICEHUB_PORT=3001
VOICEHUB_INTEGRATION_SECRET="replace-with-one-shared-random-secret-at-least-32-characters"
# VoiceHub 启动前自动执行幂等迁移；仅在外部已严格托管迁移时设为 false。
VOICEHUB_AUTO_MIGRATE=true
JWT_SECRET="cpu-web-dev-secret-please-change-in-production"
JWT_EXPIRES_IN="7d"
# 生产环境默认开放“管理后台 -> 更新部署”；可显式关闭
# ADMIN_DEPLOY_ENABLED=false
# 商城收款资料和电子交付内容的 AES-256-GCM 密钥；生产环境请固定配置且不要随意轮换
# MARKET_ENCRYPTION_SECRET="at-least-32-random-characters"
BROWSER_SESSION_IDLE_MS=1800000
BROWSER_SESSION_ABSOLUTE_MS=31536000000
JWXT_SESSION_IDLE_MS=31536000000
# CORS_ALLOWED_ORIGINS=https://cpu.example.com
# Electron OAuth2 + OpenAI 兼容接口
# OAUTH_CLIENT_ID=cpu-electron
# OAUTH_ALLOWED_REDIRECT_URIS=http://127.0.0.1,http://localhost
# ANDROID_APP_DOWNLOAD_URL=https://download.lizmt.cn/Android/CPU-Web-Android-V6.apk
# 默认已使用 Windows 文件夹分享；服务端会递归挑选其中最后更新的 .exe，可按需覆盖
# DESKTOP_PDS_SHARE_URL=https://bj37249.apps.aliyunfile.com/disk/s/TunDZWtpXk5?domainId=bj37249
# DESKTOP_PDS_SHARE_PASSWORD=
# 安卓默认复用上面的 PDS 文件夹，并自动选择版本号最高的 CPU-Web-Android-V*.apk；仅在单独分享安卓目录时覆盖
# ANDROID_APP_PDS_SHARE_URL=
# ANDROID_APP_PDS_SHARE_PASSWORD=
# 综测填表工具默认复用上面的 PDS 文件夹，只匹配“药大拾间-综测填表工具-v*.zip”；迁移到独立分享时再覆盖
# ASSESSMENT_TOOL_PDS_SHARE_URL=
# ASSESSMENT_TOOL_PDS_SHARE_PASSWORD=
# 仅在需要 PDS 故障回退时配置普通网盘地址与提取码
# DESKTOP_APP_DOWNLOAD_URL=
# DESKTOP_APP_DOWNLOAD_PASSWORD=
# DESKTOP_APP_VERSION=0.1.0
# 校园地图的查看与下载都由服务端解析下面的 PDS 分享并跳转到临时直链
# CAMPUS_MAP_PDS_SHARE_URL=https://bj37249.apps.aliyunfile.com/disk/s/RnrWbjgJ9U4?domainId=bj37249
# CAMPUS_MAP_PDS_SHARE_PASSWORD=

# ============ 腾讯云 COS 媒体存储（也可在管理后台配置） ============
# 存储桶名称必须包含 APPID 后缀，例如 cpu-web-1250000000。
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_BUCKET=cpu-web-1250000000
# TENCENT_COS_REGION=ap-shanghai
# TENCENT_COS_ROOT_PATH=cpu-web-media
# 可选：已绑定并放行读取的 CDN/自定义域名；留空使用 COS 默认域名或签名地址。
# TENCENT_COS_PUBLIC_BASE_URL=https://static.example.com

# ============ 阿里云 OSS 媒体存储（也可在管理后台配置） ============
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=cputime-static-20260901
# ALIYUN_OSS_REGION=oss-cn-shanghai
# ALIYUN_OSS_ROOT_PATH=cpu-web-media
# 可选：绑定到 ESA 的 HTTPS 静态资源域名；留空时生成短期签名地址。
# ALIYUN_OSS_PUBLIC_BASE_URL=https://static.example.com
# Web 构建静态文件可独立选择腾讯 COS 或阿里 OSS，不跟随图片/视频后端。
# WEB_STATIC_PROVIDER=cos
# 部署后默认把 COS 中 OSS 尚不存在的对象增量镜像到 OSS；不会覆盖或删除目标对象。
# COS_TO_OSS_SHADOW_MIRROR=1

# 宿舍电费代理地址
# DORM_ELECTRIC_BASE=http://sz.weicheng.wang:8899

# ============ 教务 Agent：主服务侧 ============
# 推荐在“管理后台 -> 教务节点”中添加和维护；以下变量仅用于首次启动/兼容旧部署。
# JWXT_AGENTS='[{"id":"campus-a","name":"校内节点 A","token":"至少32位且每台不同","enabled":true,"jwxtEnabled":true,"crawlEnabled":true,"weight":1,"maxConcurrent":4}]'
# JWXT_CRAWL_AGENT_ID=campus-a
# JWXT_AGENT_PATH=/api/internal/jwxt-agent/connect
# JWXT_AGENT_HEARTBEAT_MS=10000
# JWXT_AGENT_OFFLINE_MS=30000
# JWXT_LOCAL_AGENT_KEY_FILE=.jwxt-local-agent-identity.json
# JWXT_SESSION_SYNC_KEYS=new-key-at-least-32-characters,previous-key-at-least-32-characters
# 可选；用于 pending 登录、浏览器会话和本机会话缓存的 AES-256-GCM 加密。远程 Agent 快照使用各 Agent 的 RSA 身份端到端加密。
# JWXT_SESSION_SYNC_KEY=至少32位随机密钥
# SSO_LOGIN_LOCAL_ENABLED=false
# SSO_LOGIN_LOCAL_WEIGHT=1
# SSO_LOGIN_TIMEOUT_MS=15000

# ============ 旧 HTTP 教务代理兼容配置 ============
# JWXT_PROXY_URL=http://your-proxy-host:23334
# JWXT_PROXY_AUTH=shared-secret
# JWXT_PROXY_TIMEOUT_MS=15000

# 旧版仅登录节点池，保留用于平滑迁移；新部署请使用上面的出站 Agent。
# SSO_LOGIN_NODES='[{"id":"campus-a","name":"Campus node A","url":"https://proxy-a.example.com","auth":"shared-secret","enabled":true,"weight":1}]'

# ============ 教务代理：代理端 ============
# PROXY_AUTH=shared-secret
# PROXY_PORT=23334

# ============ 教务 Agent：节点机器 ============
# JWXT_AGENT_SERVER=wss://your-main-site.example.com/api/internal/jwxt-agent/connect
# JWXT_AGENT_ID=campus-a
# JWXT_AGENT_TOKEN=copy-from-admin-panel
# JWXT_AGENT_RECONNECT_MS=3000
# JWXT_AGENT_KEY_FILE=.jwxt-agent-identity.json
# REDIS_ENABLED=false
# 构建后运行：npm run jwxt-agent

# ============ Filestore ============
# FILESTORE_ENABLED=true
# FILESTORE_PORT=8974
# FILESTORE_PYTHON=python3
# FILESTORE_ADMIN_PASSWORD=admin123
