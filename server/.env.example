PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/cpu_web?schema=public"
JWT_SECRET="cpu-web-dev-secret-please-change-in-production"
JWT_EXPIRES_IN="7d"
# 商城收款资料和电子交付内容的 AES-256-GCM 密钥；生产环境请固定配置且不要随意轮换
# MARKET_ENCRYPTION_SECRET="at-least-32-random-characters"
BROWSER_SESSION_IDLE_MS=1800000
BROWSER_SESSION_ABSOLUTE_MS=31536000000
JWXT_SESSION_IDLE_MS=31536000000
# CORS_ALLOWED_ORIGINS=https://cpu.example.com
# ANDROID_APP_DOWNLOAD_URL=https://download.lizmt.cn/Android/CPU-Web-Android-V5.apk

# 宿舍电费代理地址
# DORM_ELECTRIC_BASE=http://sz.weicheng.wang:8899

# ============ 教务 Agent：主服务侧 ============
# 推荐在“管理后台 -> 教务节点”中添加和维护；以下变量仅用于首次启动/兼容旧部署。
# JWXT_AGENTS='[{"id":"campus-a","name":"校内节点 A","token":"至少32位且每台不同","enabled":true,"jwxtEnabled":true,"crawlEnabled":true,"weight":1,"maxConcurrent":4}]'
# JWXT_CRAWL_AGENT_ID=campus-a
# JWXT_AGENT_PATH=/api/internal/jwxt-agent/connect
# JWXT_AGENT_HEARTBEAT_MS=10000
# JWXT_AGENT_OFFLINE_MS=30000
# JWXT_LOCAL_AGENT_KEY_FILE=.jwxt-local-agent-identity.json
# JWXT_SESSION_SYNC_KEYS=new-key-at-least-32-characters,previous-key-at-least-32-characters
# 可选；用于 pending 登录、浏览器会话和本机会话缓存的 AES-256-GCM 加密。远程 Agent 快照使用各 Agent 的 RSA 身份端到端加密。
# JWXT_SESSION_SYNC_KEY=至少32位随机密钥
# SSO_LOGIN_LOCAL_ENABLED=false
# SSO_LOGIN_LOCAL_WEIGHT=1
# SSO_LOGIN_TIMEOUT_MS=15000

# ============ 旧 HTTP 教务代理兼容配置 ============
# JWXT_PROXY_URL=http://your-proxy-host:23334
# JWXT_PROXY_AUTH=shared-secret
# JWXT_PROXY_TIMEOUT_MS=15000

# 旧版仅登录节点池，保留用于平滑迁移；新部署请使用上面的出站 Agent。
# SSO_LOGIN_NODES='[{"id":"campus-a","name":"Campus node A","url":"https://proxy-a.example.com","auth":"shared-secret","enabled":true,"weight":1}]'

# ============ 教务代理：代理端 ============
# PROXY_AUTH=shared-secret
# PROXY_PORT=23334

# ============ 教务 Agent：节点机器 ============
# JWXT_AGENT_SERVER=wss://your-main-site.example.com/api/internal/jwxt-agent/connect
# JWXT_AGENT_ID=campus-a
# JWXT_AGENT_TOKEN=copy-from-admin-panel
# JWXT_AGENT_RECONNECT_MS=3000
# JWXT_AGENT_KEY_FILE=.jwxt-agent-identity.json
# REDIS_ENABLED=false
# 构建后运行：npm run jwxt-agent

# ============ Filestore ============
# FILESTORE_ENABLED=true
# FILESTORE_PORT=8974
# FILESTORE_PYTHON=python3
# FILESTORE_ADMIN_PASSWORD=admin123
