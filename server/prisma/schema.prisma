// 药大拾间 数据模型
// 民间学生论坛 + 学校公告爬虫聚合
// PostgreSQL + Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 用户（站内独立账号，不接学校账号） ============

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique // 登录名（学校账号登录时即为学号）
  passwordHash  String
  nickname      String   // 显示名（学校账号首次登录时为空，强制设置）
  email         String?  @unique
  avatar        String?
  bio           String?  // 自我介绍
  college       String?  // 自报院系（可选，仅展示用）
  enrollYear    Int?     // 自报入学年份（可选）
  role          String   @default("user") // user / mod / admin / bot
  // 是否通过学校 SSO 登录认证（学号身份已验证）。alice 等示例账号为 false
  studentSso    Boolean  @default(false)
  status        String   @default("active") // active / banned / muted
  mutedUntil    DateTime?
  postCount     Int      @default(0)
  replyCount    Int      @default(0)
  reputation    Int      @default(0)
  lastSeenAt    DateTime @default(now())
  lastLoginAt   DateTime?
  lastLoginClient String?
  usedIosClient Boolean  @default(false)
  usedAndroidClient Boolean @default(false)
  usedHarmonyClient Boolean @default(false)
  topicSubmissionLocked Boolean @default(false)
  aiReviewWhitelisted Boolean @default(false)
  dataAuthAgreedAt DateTime?
  forumEnabled  Boolean  @default(false)
  forumEnabledAt DateTime?
  anonymousCredits Int   @default(0)
  anonymousWeekKey String?
  anonymousCreditsFrozen Boolean @default(false)
  sponsorTotalCents Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topics            Topic[]
  manualReviewedTopics Topic[] @relation("ManualReviewedTopics")
  manualReviewedImages ForumImageAsset[] @relation("ManualReviewedImages")
  manualReviewedVideos ForumVideoAsset[] @relation("ManualReviewedVideos")
  replies           Reply[]
  likes             Like[]
  notifications     Notification[]
  notificationReads NotificationRead[]
  messageSetting    MessageSetting?
  feedSources       SchoolFeedSource[] @relation("BotUser")
  userCourses       UserCourse[]
  scheduleEdits     UserScheduleEdit[]
  scheduleWidgetTokens ScheduleWidgetToken[]
  toolPermissions   ToolPermission[]
  createdQuestionnaires Questionnaire[] @relation("QuestionnaireCreatedBy")
  questionnaireResponses QuestionnaireResponse[]
  createdGradeCheckTables GradeCheckTable[] @relation("GradeCheckCreatedBy")
  createdFileCollectTasks FileCollectTask[] @relation("FileCollectCreatedBy")
  createdFileCollectTemplates FileCollectTemplate[] @relation("FileCollectTemplateCreatedBy")
  fileCollectSubmissions FileCollectSubmission[] @relation("FileCollectSubmittedBy")
  createdRadioSemesters RadioSemester[]
  createdRadioPlayTimes RadioPlayTime[]
  createdRadioScheduleItems RadioScheduleItem[]
  radioSongRequests  RadioSongRequest[] @relation("RadioSongRequestRequester")
  reviewedRadioSongRequests RadioSongRequest[] @relation("RadioSongRequestReviewedBy")
  updatedRadioMusicAuthRecords RadioMusicAuth[]
  sponsorOrders    SponsorOrder[]
  qqBotBindings     QqBotBinding[]
  qqBotBindTokens   QqBotBindToken[]
  qqBotMessageLogs  QqBotMessageLog[]
  forumImageAssets  ForumImageAsset[]
  forumVideoAssets  ForumVideoAsset[]
  aiReviewLogs      AiReviewLog[]
  courseBotQuota    CourseBotQuota?
  courseBotUsageLogs CourseBotUsageLog[]
}

// ============ 论坛核心 ============

model Board {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // 路由用 slug，如 hot / question / market / coursereview / news-jwc
  name        String
  description String?
  icon        String?  // emoji 或 element icon name
  color       String?  // 板块色（hex）
  order       Int      @default(0)
  // type 控制板块特殊行为：
  //   normal      普通板块
  //   announce    只读公告板（爬虫机器人发帖）
  //   market      二手市场（topic.metadata 含 price/condition/images）
  //   question    提问广场（topic.metadata 含 resolved/bounty）
  //   coursereview 课程点评（topic.metadata 含 courseId/ratings）
  type        String   @default("normal")
  // 只读板块发帖人必须是 bot
  readOnly    Boolean  @default(false)
  anonymousEnabled Boolean @default(false)
  topicCount  Int      @default(0)
  // 关联爬虫源（announce 类型板块独有）
  feedSourceId Int?    @unique
  feedSource  SchoolFeedSource? @relation(fields: [feedSourceId], references: [id])
  weiwallSyncConfigs WeiwallSyncConfig[]

  topics Topic[]

  @@index([order])
  @@index([type, order])
}

model Topic {
  id          Int       @id @default(autoincrement())
  boardId     Int
  authorId    Int
  title       String
  // 正文内容（Markdown 源码）
  content     String
  // 板块特化字段，JSON 字符串。
  //   market:       {"price": 100, "condition":"九成新", "images":["..."], "tradeMode":"当面"}
  //   question:     {"resolved":false, "bounty":0, "tags":["数据结构"]}
  //   coursereview: {"courseId":12,"ratings":{"difficulty":3,"reward":5,"recommend":4,"score":2}}
  //   announce:     {"sourceUrl":"...", "publishedAt":"2026-05-14"}
  metadata    String    @default("{}")
  aiReviewStatus String @default("none") // none / checking / auto_passed / blocked_ai / manual_requested / manual_reviewing / approved_manual / rejected_manual
  aiRiskLevel String? // low / medium / high
  aiRiskScore Int? // 0-100
  aiReviewReason String?
  aiReviewDetail String?
  aiModel String?
  aiReviewedAt DateTime?
  manualReviewedById Int?
  manualReviewedAt DateTime?
  manualReviewNote String?
  isAnonymous Boolean   @default(false)
  anonymousAlias String?
  editCount    Int       @default(0)
  pinned      Boolean   @default(false)
  locked      Boolean   @default(false) // 锁帖后不能回复
  hidden      Boolean   @default(false) // 被管理员隐藏
  viewCount   Int       @default(0)
  replyCount  Int       @default(0)
  likeCount   Int       @default(0)
  lastReplyAt DateTime? // 用于排序
  lastReplyById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board   Board   @relation(fields: [boardId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])
  replies Reply[]
  likes   Like[]
  tags    TopicTag[]
  manualReviewedBy User? @relation("ManualReviewedTopics", fields: [manualReviewedById], references: [id])
  weiwallMap WeiwallTopicMap?

  @@index([boardId, lastReplyAt])
  @@index([boardId, hidden, createdAt])
  @@index([hidden, createdAt])
  @@index([hidden, lastReplyAt])
  @@index([authorId])
  @@index([authorId, aiReviewStatus])
}

model Reply {
  id            Int      @id @default(autoincrement())
  topicId       Int
  authorId      Int
  content       String   // Markdown
  aiReviewStatus String  @default("none") // none / auto_passed / blocked_ai / manual_requested / manual_reviewing / approved_manual / rejected_manual
  aiRiskLevel   String?
  aiRiskScore   Int?
  aiReviewReason String?
  aiReviewDetail String?
  aiModel       String?
  aiReviewedAt  DateTime?
  // 楼中楼：parentReplyId 指向父级回复，null 表示直接对主帖
  parentReplyId Int?
  isAnonymous  Boolean  @default(false)
  anonymousAlias String?
  // 排序楼层号
  floor         Int      @default(0)
  likeCount     Int      @default(0)
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  topic       Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author      User    @relation(fields: [authorId], references: [id])
  parentReply Reply?  @relation("ReplyToReply", fields: [parentReplyId], references: [id])
  children    Reply[] @relation("ReplyToReply")
  likes       Like[]
  weiwallMap  WeiwallReplyMap?

  @@index([topicId, floor])
  @@index([topicId, hidden, floor])
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  topicId   Int?
  replyId   Int?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reply Reply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, replyId])
}

model ForumImageAsset {
  id            Int      @id @default(autoincrement())
  url           String   @unique
  localPath     String
  mimeType      String?
  fileSize      Int?
  status        String   @default("pending") // pending / approved / rejected / error
  reason        String?
  detail        String?
  reviewModel   String?
  reviewEndpoint String?
  reviewedAt    DateTime?
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  attemptCount  Int      @default(0)
  lastError     String?
  createdById   Int?
  manualReviewedById Int?
  manualReviewedAt DateTime?
  manualReviewNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  manualReviewedBy User? @relation("ManualReviewedImages", fields: [manualReviewedById], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt, createdAt])
  @@index([createdById, createdAt])
}

model ForumVideoAsset {
  id            Int      @id @default(autoincrement())
  url           String   @unique
  localPath     String
  mimeType      String?
  fileSize      Int?
  durationMs    Int?
  width         Int?
  height        Int?
  hasAudio      Boolean  @default(false)
  transcript    String?
  transcriptStatus String?
  status        String   @default("pending") // pending / approved / rejected / manual_review / error
  reason        String?
  detail        String?
  reviewModel   String?
  reviewEndpoint String?
  reviewedAt    DateTime?
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  attemptCount  Int      @default(0)
  lastError     String?
  createdById   Int?
  manualReviewedById Int?
  manualReviewedAt DateTime?
  manualReviewNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  manualReviewedBy User? @relation("ManualReviewedVideos", fields: [manualReviewedById], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt, createdAt])
  @@index([createdById, createdAt])
}

model AiReviewLog {
  id              Int      @id @default(autoincrement())
  kind            String   // topic / reply / topic-edit / image
  targetId        Int?
  targetLabel     String?
  targetUrl       String?
  provider        String
  model           String
  endpoint        String?
  status          String   @default("started") // started / success / error
  requestSummary  String   @default("")
  responseSummary String   @default("")
  errorMessage    String?
  createdById     Int?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([kind, startedAt])
  @@index([status, startedAt])
  @@index([targetId, kind, startedAt])
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  topics TopicTag[]
}

model TopicTag {
  topicId Int
  tagId   Int

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([topicId, tagId])
}

// ============ 课程点评聚合（衍生于 coursereview 板块的 Topic） ============

model Course {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  // 旧字段：保留以兼容历史数据。新代码请通过 courseTeachers 读取多老师。
  // 数据迁移见 migrations/20260515090000_add_teachers。
  teacher  String
  credits  Float?
  category String? // 必修/选修/通识
  college  String?

  // 聚合统计（由 CourseRating 计算后回写）
  ratingCount   Int   @default(0)
  avgDifficulty Float @default(0)
  avgReward     Float @default(0)
  avgRecommend  Float @default(0)
  avgScore      Float @default(0)

  userCourses    UserCourse[]
  courseTeachers CourseTeacher[]
}

// 老师（与课程多对多，由 CourseTeacher 关联）
model Teacher {
  id        Int      @id @default(autoincrement())
  name      String   @unique // 同名老师暂归为同一人；后续 admin 后台可拆分
  college   String?
  // 用户自助添加来源标记：留作后续审核合并用
  createdById Int?
  createdAt DateTime @default(now())

  courseTeachers CourseTeacher[]
}

// 课程-老师 关联（一个老师在一门课上的"授课记录"，可跨学期累计）
model CourseTeacher {
  id        Int    @id @default(autoincrement())
  courseId  Int
  teacherId Int
  // 来源：'jwxt-pyfa' | 'jwxt-grade' | 'user-add' | 'seed' | 'backfill'
  source    String @default("user-add")
  createdAt DateTime @default(now())

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  ratings CourseRating[]

  @@unique([courseId, teacherId])
  @@index([courseId])
  @@index([teacherId])
}

// 学生与课程的关联（来自同步教务系统）
model UserCourse {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  source    String   // 'grade' (有成绩) / 'pyfa' (培养方案里)
  semester  String?  // 学期，仅 grade 来源时有
  score     String?  // 成绩，仅 grade 来源时有
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

// 课表编辑上云（按用户 + 学期存一份编辑状态）
model UserScheduleEdit {
  id        Int      @id @default(autoincrement())
  userId    Int
  semester  String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, semester])
  @@index([userId, updatedAt])
}

// iOS Scriptable 小组件只读 token。
// 注意：这里保存的是服务端教务会话 token 和最近一次成功的小组件课表缓存，不保存学校账号密码。
model ScheduleWidgetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String?
  tokenHash String   @unique
  tokenSuffix String
  jwxtToken String
  cachedPayload String?
  cachedAt DateTime?
  lastUsedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastUsedAt])
}

// 一个学生对一门课的评分（与 Topic 1:1 关联）
model CourseRating {
  id         Int   @id @default(autoincrement())
  topicId    Int   @unique
  courseId   Int
  // 关联到具体的"课程-老师"组合；旧数据 nullable
  courseTeacherId Int?
  authorId   Int
  // 评分维度（1-5）
  difficulty Int   // 难度
  reward     Int   // 收获
  recommend  Int   // 推荐度
  givingScore Int  // 给分（1=低 5=高）
  // 上学期 / 学年
  semester   String?

  createdAt  DateTime @default(now())

  courseTeacher CourseTeacher? @relation(fields: [courseTeacherId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([courseTeacherId])
}

// ============ 学校爬虫源 ============

model SchoolFeedSource {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String  // 显示名："教务通知" "学工动态"
  homepage    String  // 学校原始入口（用于"查看原文"）
  listUrl     String  // 列表 URL，可包含 {page} 占位符
  pageSize    Int     @default(14) // 每页条数（学校 CMS 通常 14）
  maxPages    Int     @default(2) // 抓多少页
  // 解析规则（JSON，预留扩展。MVP 用硬编码 selector）
  parser      String  @default("school-cms-v1")
  cronMinutes Int     @default(15) // 每 N 分钟抓一次
  enabled     Boolean @default(true)
  // 机器人账号（自动发帖用）
  botUserId   Int
  lastRunAt   DateTime?
  lastRunOk   Boolean? // 上次是否成功
  lastError   String?

  botUser User   @relation("BotUser", fields: [botUserId], references: [id])
  board   Board?

  @@index([enabled])
}

// 已经抓取过的官方公告（去重用）
model SchoolFeedItem {
  id          Int      @id @default(autoincrement())
  sourceId    Int
  externalId  String   // URL 中的 c{boardId}a{infoId} 部分，唯一
  url         String   // 详情页全 URL
  title       String
  publishedAt DateTime
  topicId     Int?     // 对应在论坛中创建的 Topic
  createdAt   DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([sourceId])
}

// ============ 外部逛逛同步（WeiWall / 逛逛校园圈） ============

model WeiwallSyncConfig {
  id               Int      @id @default(autoincrement())
  enabled          Boolean  @default(false)
  baseUrl          String   @default("https://s.weiwall.com")
  schoolEn         String   @default("cpu")
  tenantId         Int      @default(7)
  token            String   @default("")
  intervalSeconds  Int      @default(120)
  topicPages       Int      @default(3)
  commentPageSize  Int      @default(20)
  maxCommentPages  Int      @default(10)
  maxReplyPages    Int      @default(10)
  boardId          Int?
  lastRunAt        DateTime?
  lastRunOk        Boolean?
  lastError        String?
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  board Board? @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@index([enabled])
}

model WeiwallTopicMap {
  id               Int      @id @default(autoincrement())
  externalTopicId  String   @unique
  localTopicId     Int      @unique
  externalAuthorKey String?
  externalAuthorUuid String?
  externalAuthorName String?
  externalAuthorAvatar String?
  externalCreatedAt DateTime?
  lastCommentCount Int      @default(0)
  lastLikeCount    Int      @default(0)
  lastStatus       String?
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  localTopic Topic @relation(fields: [localTopicId], references: [id], onDelete: Cascade)

  @@index([lastSyncedAt])
}

model WeiwallReplyMap {
  id                    Int      @id @default(autoincrement())
  externalReplyId       String   @unique
  localReplyId          Int      @unique
  externalTopicId       String
  externalCommentId     String?
  parentExternalReplyId String?
  externalAuthorUuid    String?
  externalAuthorName    String?
  externalAuthorAvatar  String?
  externalCreatedAt     DateTime?
  lastSyncedAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  localReply Reply @relation(fields: [localReplyId], references: [id], onDelete: Cascade)

  @@index([externalTopicId, externalCreatedAt])
}

// ============ 服务导航卡片（学校原入口外链） ============

model ServiceCard {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  category    String   // 教务 / 卡务 / 健康 / 生活 / 就业 / 信息化
  owner       String   // 责任部门
  icon        String?
  description String?
  url         String   // 学校原入口
  materials   String?  // 所需材料
  duration    String?  // 办理时长
  contact     String?  // 咨询方式
  needSso     Boolean  @default(false) // 是否需要先登录学校 SSO
  // 排序权重
  order       Int      @default(0)
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([hidden, order])
}

// ============ 校园小工具权限 ============

model ToolPermission {
  id        Int      @id @default(autoincrement())
  toolCode  String
  userId    Int
  role      String   @default("manager") // manager
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolCode, userId])
  @@index([toolCode])
  @@index([userId])
}

model ToolSetting {
  id                Int      @id @default(autoincrement())
  toolCode          String   @unique
  isVisible         Boolean  @default(true)
  requireLogin      Boolean  @default(false)
  allowPublicManage Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isVisible])
  @@index([requireLogin])
  @@index([allowPublicManage])
}

// ============ 小工具：问卷系统 ============

model Questionnaire {
  id                 Int      @id @default(autoincrement())
  toolCode           String   @default("questionnaire")
  slug               String   @unique
  title              String
  description        String?
  status             String   @default("draft") // draft / open / closed
  visibility         String   @default("public") // public / login
  allowAnonymous     Boolean  @default(true)
  oneResponsePerUser Boolean  @default(false)
  isSystem           Boolean  @default(false)
  qqBotNotifyEnabled Boolean  @default(true)
  qqBotNotifyConfig  String   @default("{}")
  fields             String   @default("[]")
  createdById        Int?
  publishedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User? @relation("QuestionnaireCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  responses QuestionnaireResponse[]

  @@index([toolCode, status])
  @@index([createdById])
}

model QuestionnaireResponse {
  id              Int      @id @default(autoincrement())
  questionnaireId Int
  respondentId    Int?
  answers         String
  createdAt       DateTime @default(now())

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  respondent    User? @relation(fields: [respondentId], references: [id], onDelete: SetNull)

  @@index([questionnaireId, createdAt])
  @@index([respondentId])
}

// ============ 小工具：成绩表核对 ============

model GradeCheckTable {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  description     String?
  status          String   @default("open") // draft / open / closed
  studentIdColumn String   @default("学号")
  columns         String   @default("[]")
  rowCount        Int      @default(0)
  feedbackQuestionnaireSlug String?
  qqBotNotifyEnabled Boolean @default(true)
  qqBotNotifyConfig String @default("{}")
  createdById     Int?
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("GradeCheckCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rows      GradeCheckRow[]

  @@index([status])
  @@index([createdById])
}

model GradeCheckRow {
  id        Int      @id @default(autoincrement())
  tableId   Int
  studentId String
  payload   String
  createdAt DateTime @default(now())

  table GradeCheckTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, studentId])
  @@index([studentId])
}

// ============ 小工具：文件收集 ============

model FileCollectTask {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
