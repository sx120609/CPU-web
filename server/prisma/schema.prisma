  allowKick            Boolean  @default(false)
  allowKickAndBlock    Boolean  @default(false)
  commandUserQqIds     String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([enabled])
}

model QqBotGroupJoinRequest {
  id            Int       @id @default(autoincrement())
  groupId       String
  qqId          String
  nickname      String?
  comment       String?
  flag          String    @unique
  status        String    @default("pending") // pending / approved / rejected / expired
  handledAction String?
  handledByQqId String?
  rawPayload    String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  handledAt     DateTime?

  @@index([groupId, status, createdAt])
  @@index([qqId, status, createdAt])
}

model QqBotGroupBlockedUser {
  id            Int      @id @default(autoincrement())
  groupId       String
  qqId          String
  nickname      String?
  blockedByQqId String?
  source        String   @default("manual") // manual / command / join-request
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, qqId])
  @@index([groupId, createdAt])
  @@index([qqId, createdAt])
}

model QqBotGroupAdStrike {
  id            Int      @id @default(autoincrement())
  groupId       String
  qqId          String
  nickname      String?
  hitCount      Int      @default(0)
  lastReason    String?
  lastRiskScore Int?
  lastModel     String?
  lastHitAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, qqId])
  @@index([groupId, lastHitAt])
  @@index([qqId, lastHitAt])
}

model QqBotGroupAdVerification {
  id        Int       @id @default(autoincrement())
  groupId   String
  qqId      String
  nickname  String?
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([groupId, qqId, expiresAt])
  @@index([qqId, codeHash])
  @@index([qqId, expiresAt])
}

model QqBotGroupAdReport {
  id                 Int       @id @default(autoincrement())
  tokenHash          String    @unique
  groupId            String
  groupName          String?
  offenderQqId       String
  offenderNickname   String?
  reason             String
  hitCount           Int
  status             String    @default("open") // open / handled / expired
  reportMessageId    String?
  expiresAt          DateTime
  handledAt          DateTime?
  handledByQqId      String?
  handledAction      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([groupId, status, createdAt])
  @@index([groupId, offenderQqId, status])
}

model QqBotGroupAdWhitelist {
  id        Int      @id @default(autoincrement())
  groupId   String
  qqId      String
  nickname  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, qqId])
  @@index([groupId, expiresAt])
  @@index([qqId, expiresAt])
}

model QqBotMessageLog {
  id             Int      @id @default(autoincrement())
  direction      String // inbound / outbound
  eventType      String
  status         String   @default("ok") // ok / ignored / error
  qqId           String?
  groupId        String?
  messageId      String?
  userId         Int?
  topicId        Int?
  notificationId Int?
  command        String?
  content        String   @default("")
  result         String   @default("")
  rawPayload     String   @default("{}")
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([qqId, createdAt])
  @@index([userId, createdAt])
  @@index([notificationId, userId])
}

model QqBotConversation {
  id              Int      @id @default(autoincrement())
  qqId            String
  groupId         String?
  scene           String
  status          String   @default("active")
  step            String
  draftTitle      String?
  draftContent    String   @default("")
  draftBoardSlug  String?
  sourceMessageId String?
  sourceSummary   String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([qqId, status, updatedAt])
  @@index([groupId, status, updatedAt])
}

// ============ 站点功能开关 ============
// KV 风格存储。当前用法：
//   feature.forum         = 'on' | 'off'  控制论坛通用板块（包括 /forum 入口、发帖）
//   feature.market        = 'on' | 'off'  控制二手市场
//   feature.coursereview  = 'on' | 'off'  控制课程点评
// 出于"言论敏感时一键下架"的考虑，admin 可在管理后台随时切换。
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============ 刷课工具：AI 答题额度与消耗 ============
// 视频刷课免费（拉人气），仅 AI 答题计费。
//   CourseBotQuota: 每用户一行，存 AI 答题余额与累计统计
//   CourseBotUsageLog: 每次答题消耗流水，同时作为"错题沉淀"库（questionHash 去重）

model CourseBotQuota {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  aiBalance     Int      @default(0) // AI 答题剩余额度（题数）
  totalConsumed Int      @default(0) // 累计消耗
  totalGranted  Int      @default(0) // 累计获得（admin 发放 + 购买）
  note          String? // 备注（admin 发放时填写）
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aiBalance])
}

model CourseBotUsageLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  questionHash String // 题干归一化指纹，用于错题沉淀与命中去重
  questionText String // 题干快照（截断存储）
  aiAnswer     String // AI 给出的答案
  correct      Boolean? // 是否答对：null=未知/填空待确认，true/false=已知
  cost         Int      @default(1) // 本次消耗额度
  model        String? // 使用的 AI 模型
  platform     String   @default("chaoxing") // chaoxing / zhihuiredao
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionHash])
  @@index([userId, questionHash])
}

model AdminDailyLogin {
  id           Int      @id @default(autoincrement())
  userId       Int
  dateKey      String
  client       String?
  firstLoginAt DateTime @default(now())
  lastLoginAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@index([dateKey, userId])
  @@index([userId, lastLoginAt])
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  clientId            String
  redirectUri         String
  userId              Int
  scope               String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([clientId, expiresAt])
}

model OAuthAccessToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  clientId   String
  userId     Int
  scope      String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([clientId, expiresAt])
}
