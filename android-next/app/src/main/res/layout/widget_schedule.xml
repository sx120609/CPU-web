<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:text="药大课表"
            android:textColor="#172033"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_refresh_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="刷新"
            android:textColor="#168776"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="正在更新"
        android:textColor="#667085"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_line_1"
            style="@style/WidgetScheduleLine"
            android:text="打开 App 添加课表小组件" />

        <TextView
            android:id="@+id/widget_line_2"
            style="@style/WidgetScheduleLine" />

        <TextView
            android:id="@+id/widget_line_3"
            style="@style/WidgetScheduleLine" />

        <TextView
            android:id="@+id/widget_line_4"
            style="@style/WidgetScheduleLine" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="配置后会自动刷新"
        android:textColor="#98A2B3"
        android:textSize="10sp" />
</LinearLayout>
