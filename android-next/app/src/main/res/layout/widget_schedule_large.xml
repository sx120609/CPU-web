<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="13dp"
    android:paddingEnd="15dp"
    android:paddingBottom="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:text="药大课表"
            android:textColor="#172033"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_refresh_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="刷新"
            android:textColor="#168776"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="正在更新"
        android:textColor="#667085"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_left_title"
                style="@style/WidgetScheduleSectionTitle"
                android:text="今日时间线" />

            <TextView
                android:id="@+id/widget_left_line_1"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_left_line_2"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_left_line_3"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_left_line_4"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_left_line_5"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_left_line_6"
                style="@style/WidgetScheduleLineDense" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#E2EAF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_right_title"
                style="@style/WidgetScheduleSectionTitle"
                android:text="明日预览" />

            <TextView
                android:id="@+id/widget_right_line_1"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_right_line_2"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_right_line_3"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_right_line_4"
                style="@style/WidgetScheduleLineDense" />

            <TextView
                android:id="@+id/widget_right_line_5"
                style="@style/WidgetScheduleLineDense" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="配置后会自动刷新"
        android:textColor="#98A2B3"
        android:textSize="10sp" />
</LinearLayout>
